<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Główne motywy aplikacji - zmieniono na motyw platformowy dostępny bez dodatkowych bibliotek -->
    <style name="Theme.Trasy" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Motyw dla Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">
            @drawable/ic_launcher_foreground
        </item>
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="postSplashScreenTheme">@style/Theme.Trasy</item>
    </style>
</resources>
